// Prisma schema for ILA — Inventory & Logistics Automation
// Status/role/type fields use String (not enum) so the schema works on both
// SQLite (dev) and PostgreSQL (prod). Allowed values live in src/constants.ts
// and are validated with zod at the API layer.
//
// Multi-tenant: every tenant-owned row carries a companyId. Queries MUST scope
// by the logged-in user's companyId for isolation. (Round 1: companyId optional
// so existing rows can be backfilled before it's made required.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Hosted Postgres (Supabase). DATABASE_URL = pooled connection (Supavisor, port
  // 6543, ?pgbouncer=true) used by the app; DIRECT_URL = direct connection (port
  // 5432) used by Prisma Migrate. See apps/api/.env.example for the format.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  warehouses     Warehouse[]
  products       Product[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  routes         Route[]
  customers      Customer[]
  orders         Order[]
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STAFF") // ADMIN | MANAGER | STAFF | DRIVER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  orders         Order[]
  routesDriven   Route[]         @relation("RouteDriver")

  productVisibility ProductVisibility[]
}

// ---------------------------------------------------------------------------
// Locations
// ---------------------------------------------------------------------------
model Warehouse {
  id        String   @id @default(cuid())
  code      String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  orders         Order[]

  @@unique([companyId, code])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------
model Product {
  id           String   @id @default(cuid())
  sku          String
  name         String
  description  String?
  category     String?
  unit         String   @default("each") // each, kg, box, etc.
  barcode      String?
  unitCost     Float    @default(0) // purchase cost
  unitPrice    Float    @default(0) // sale price
  reorderPoint Int      @default(0) // alert at/below this total quantity
  reorderQty   Int      @default(0) // suggested reorder quantity
  visibility   String   @default("COMPANY") // COMPANY | RESTRICTED | ADMINS_ONLY (see constants.ts)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  orderItems         OrderItem[]
  visibleTo          ProductVisibility[]
  hiddenRoles        ProductHiddenRole[]

  @@unique([companyId, sku])
}

// Per-user product visibility, used when Product.visibility is RESTRICTED: the
// product is visible only to the listed users (admins always see all products).
model ProductVisibility {
  productId String
  userId    String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([productId, userId])
  @@index([userId])
}

// Roles a product is hidden from, used when Product.visibility is BY_ROLE. A user
// whose role is listed here cannot see the product. Only non-admin roles appear
// (admins always retain access). See HIDEABLE_ROLES in constants.ts.
model ProductHiddenRole {
  productId String
  role      String // MANAGER | STAFF

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, role])
}

// ---------------------------------------------------------------------------
// Stock: current levels (per product+warehouse) and an immutable movement log
// (Scoped to a company via their product/warehouse relations.)
// ---------------------------------------------------------------------------
model StockLevel {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  type        String // ADJUSTMENT | RECEIPT | DELIVERY | TRANSFER_IN | TRANSFER_OUT
  quantity    Int // signed delta: positive = in, negative = out
  reason      String?
  reference   String? // e.g. PO or order number
  userId      String?
  createdAt   DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([warehouseId])
}

// ---------------------------------------------------------------------------
// Suppliers & purchase orders (inbound)
// ---------------------------------------------------------------------------
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  products       Product[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id          String    @id @default(cuid())
  number      String
  supplierId  String
  warehouseId String? // destination warehouse for received goods
  status      String    @default("DRAFT") // DRAFT | AWAITING_CONFIRMATION | ORDERED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED | DECLINED
  notes       String?
  orderedAt       DateTime?
  expectedAt      DateTime?
  nextExpectedAt  DateTime? // next delivery date when partially received
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User?               @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@unique([companyId, number])
}

model PurchaseOrderItem {
  id              String @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Float  @default(0)
  receivedQty     Int    @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

// ---------------------------------------------------------------------------
// Distribution: routes, customers & orders (outbound)
//
// A Route belongs to one Driver (a User with role DRIVER) and groups Customers.
// A Customer is assigned to a Route; the orders they place inherit that route
// (snapshotted onto the Order as routeId so it stays stable if reassigned).
// ---------------------------------------------------------------------------
model Route {
  id        String   @id @default(cuid())
  name      String
  code      String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  driverId String? // a User with role DRIVER
  driver   User?   @relation("RouteDriver", fields: [driverId], references: [id])

  customers Customer[]
  orders    Order[]

  @@unique([companyId, name])
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  routeId String? // the route this customer belongs to
  route   Route?  @relation(fields: [routeId], references: [id])

  orders Order[]
}

model Order {
  id          String    @id @default(cuid())
  number      String
  status      String    @default("UNCONFIRMED") // UNCONFIRMED | CONFIRMED | PREORDER | DELIVERED | CANCELLED
  notes       String?
  warehouseId String? // source warehouse goods are delivered from
  confirmedAt DateTime?
  deliveredAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Snapshot of the customer's route at order time (stays put if the customer
  // is later moved to another route).
  routeId String?
  route   Route?  @relation(fields: [routeId], references: [id])

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  createdBy User?      @relation(fields: [createdById], references: [id])
  items     OrderItem[]

  @@unique([companyId, number])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float  @default(0) // captured from the product when added
  discount  Float  @default(0) // percent off this line (0–100)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
