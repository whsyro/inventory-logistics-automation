# --- Database (Supabase Postgres) ---
# Get both strings from the Supabase dashboard: Connect → ORMs → Prisma.
# Replace [PROJECT-REF], [PASSWORD] and [REGION] with your project's values.
#
# DATABASE_URL = pooled connection (Supavisor, transaction mode, port 6543). Used
#   by the app at runtime. The pgbouncer flag is required for the pooler.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL = direct/session connection (port 5432). Used only by Prisma Migrate.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
#
# Local SQLite fallback (to revert: set provider="sqlite" in prisma/schema.prisma):
# DATABASE_URL="file:./dev.db"

# --- Auth ---
# Change this to a long random string in production.
JWT_SECRET="dev-secret-change-me-please-0123456789"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:5173"
# Base URL of THIS api, used to build supplier order-confirmation links.
APP_BASE_URL="http://localhost:4000"

# --- Email ---
MAIL_FROM="\"ILA Orders\" <orders@ila.local>"
# Preview mode (no real emails): "ethereal" = test inbox w/ preview URL, "json" = offline log.
MAIL_TRANSPORT="ethereal"
# To send REAL emails, set these (overrides MAIL_TRANSPORT):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="apikey-or-username"
# SMTP_PASS="your-password"
