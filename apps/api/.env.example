# --- Database ---
# SQLite for local dev (no setup required).
# For PostgreSQL: set provider = "postgresql" in prisma/schema.prisma and use a
# connection string like: postgresql://user:pass@localhost:5432/ila
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Change this to a long random string in production.
JWT_SECRET="dev-secret-change-me-please-0123456789"
JWT_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:5173"
# Base URL of THIS api, used to build supplier order-confirmation links.
APP_BASE_URL="http://localhost:4000"

# --- Email ---
MAIL_FROM="\"ILA Orders\" <orders@ila.local>"
# Preview mode (no real emails): "ethereal" = test inbox w/ preview URL, "json" = offline log.
MAIL_TRANSPORT="ethereal"
# To send REAL emails, set these (overrides MAIL_TRANSPORT):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="apikey-or-username"
# SMTP_PASS="your-password"
